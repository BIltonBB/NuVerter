{
  "productName": "NuVerter",
  "version": "1.1.35",
  "identifier": "com.nuverter.studio",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NuVerter",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQzNFRjlEMjdFNTI2NkYKUldSdkp1VW5uZS9EVGlYZGR0Y2tJM0YvVHc3TlRwRjlFa0M0bXZIZHk4amtpdzlIazFjMVJUNTgK",
      "endpoints": [
        "https://raw.githubusercontent.com/BIltonBB/NuVerter/main/latest.json"
      ]
    }
  }
}
