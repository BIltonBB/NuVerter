# Desktop bundle (published via GitHub Releases, not Pages)
web/NuVerter-Tauri-Portable.zip

# Build artifacts
bin/
obj/
*.user

# Local build logs
/build*.log
/tauri_build*.log
/cargo_check.log

# Scratch scripts and agent working folders (one-off, not part of the app)
/patch_*.py
/patch_*.cjs
/gen_images.ps1
.freebuff/

# Dependencies
node_modules/

# OS + sync client temp folders
.DS_Store
Thumbs.db
.tmp.driveupload/

# Rust/Tauri build
tauri/src-tauri/target/

# Updater signing keys are secret; keep them on the machine only
tauri/src-tauri/.tauri/

# Android build output, generated glue and local signing material
tauri/dist/
tauri/src-tauri/gen/android/app/build/
tauri/src-tauri/gen/android/build/
tauri/src-tauri/gen/android/.gradle/
tauri/src-tauri/gen/android/local.properties
tauri/src-tauri/gen/android/keystore.properties
tauri/src-tauri/gen/android/*.jks
tauri/src-tauri/gen/android/tauri.settings.gradle
tauri/src-tauri/gen/android/app/tauri.build.gradle.kts
tauri/src-tauri/gen/android/app/src/main/jniLibs/
tauri/src-tauri/gen/android/app/proguard-tauri.pro
tauri/src-tauri/gen/android/app/src/main/java/**/generated/
